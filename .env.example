# Railway/runtime: Supabase Transaction Pooler (port 6543).
NODE_ENV="development"
APP_ENV="development"
PORT="3000"
TZ="America/Sao_Paulo"
DATABASE_CONNECTION_LIMIT="1"
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# Prisma CLI/migrations: prefer Supabase Session Pooler (port 5432).
# If unavailable, keep migrations manual and use the SQL Editor only as plan B.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Alternative to SUPABASE_ANON_KEY for newer Supabase projects.
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
CORS_ALLOWED_ORIGINS="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"
NEXTSTOCK_PUBLIC_URL="http://localhost:3000"
SUPABASE_PASSWORD_REDIRECT_URL="http://localhost:3000/login.html"
CSP_ENFORCE="true"
# Set CSP_REPORT_ONLY="true" for temporary rollback/report-only telemetry.
CSP_REPORT_ONLY="false"
COMPRESSION_THRESHOLD_BYTES="1024"

JWT_SECRET=""
JWT_DIAGNOSTIC_LOGS="false"

DEV_SUPER_ADMIN_EMAILS=""
DEV_SUPER_ADMIN_USER_IDS=""
DEV_RAILWAY_MONTHLY_COST_CENTS=""
DEV_SUPABASE_MONTHLY_COST_CENTS=""

RAILWAY_API_TOKEN=""
RAILWAY_PROJECT_ID=""
RAILWAY_ENVIRONMENT_ID=""
RAILWAY_SERVICE_ID=""

SUPABASE_PROJECT_REF=""
# Guardrail references. Set both in Railway; never put credentials here.
PRODUCTION_SUPABASE_PROJECT_REF=""
STAGING_SUPABASE_PROJECT_REF=""
PRODUCTION_APP_HOST=""
SUPABASE_ACCESS_TOKEN=""

SUPABASE_STORAGE_BUCKET_PET_PHOTOS="pet-photos"
PET_PHOTO_MAX_SIZE_MB="5"
SUPABASE_STORAGE_BUCKET_PRODUCT_IMAGES="product-images"
PRODUCT_IMAGE_MAX_SIZE_MB="5"
SUPABASE_STORAGE_BUCKET_EXPENSE_FILES="expense-files"
EXPENSE_FILE_MAX_SIZE_MB="10"
SUPABASE_STORAGE_BUCKET_SALE_DOCUMENTS="sale-documents"
SUPABASE_STORAGE_SIGNED_URLS="true"
# MEM-016 conservative per-replica image processing limits.
IMAGE_PROCESSING_CONCURRENCY="1"
IMAGE_PROCESSING_MAX_QUEUE="4"
IMAGE_PROCESSING_QUEUE_TIMEOUT_MS="15000"
IMAGE_PROCESSING_TIMEOUT_MS="30000"
IMAGE_PROCESSING_PER_TENANT="1"
IMAGE_MAX_INPUT_PIXELS="20000000"
UPLOAD_ENABLE_QUOTAS="false"
UPLOAD_DAILY_BYTES_PER_TENANT="524288000"
UPLOAD_DAILY_FILES_PER_TENANT="200"
UPLOAD_DAILY_BYTES_PER_USER="104857600"
UPLOAD_STORAGE_BYTES_PER_TENANT="5368709120"
UPLOAD_SIGNED_URL_TTL_SECONDS="600"

# Development-only seed. Both values are required; production never seeds demo data.
NEXTSTOCK_DEMO_TENANT_ID=""
NEXTSTOCK_DEMO_BRANCH_ID=""

# SaaS billing. Keep enforcement disabled until migration, seed and backfill are verified.
BILLING_DEFAULT_PROVIDER="mercado_pago"
BILLING_MODE="production"
BILLING_ENFORCEMENT_ENABLED="false"
BILLING_CHECKOUT_ENABLED="true"
BILLING_WEBHOOK_ENABLED="false"
BILLING_EXTERNAL_REFERENCE_SECRET=""
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_COLLECTOR_ID=""
MERCADO_PAGO_MODE="production"
MERCADO_PAGO_PLAN_ID_OURO=""
MERCADO_PAGO_PLAN_ID_ESMERALDA=""
MERCADO_PAGO_PLAN_ID_DIAMANTE=""
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS="600"

# A1 certificate encryption and private storage.
CERT_ENCRYPTION_KEY=""
CERT_ENCRYPTION_KEY_VERSION="v1"
SUPABASE_STORAGE_BUCKET_FISCAL_CERTIFICATES="fiscal-certificates"
CERTIFICATE_MAX_SIZE_MB="5"

# Security audit hashing. Use a unique random value per environment (32+ chars).
AUDIT_HASH_SECRET=""
SESSION_HASH_SECRET=""
SESSION_ENFORCEMENT_ENABLED="false"
SESSION_RETENTION_DAYS="120"
AUDIT_LOG_ENVIRONMENT="development"
SENTRY_ENVIRONMENT="development"
SENTRY_DSN=""
SENTRY_RELEASE=""
AUDIT_OUTBOX_ALERTING_ENABLED="true"
AUDIT_OUTBOX_BACKLOG_ALERT_THRESHOLD="100"
AUDIT_OUTBOX_LAG_SLA_SECONDS="300"
AUDIT_OUTBOX_SHUTDOWN_TIMEOUT_MS="10000"
AUDIT_OUTBOX_ALERT_COOLDOWN_SECONDS="300"

# Optional runtime/system defaults.
NEXTSTOCK_SYSTEM_MODE=""
NEXTSTOCK_TENANT_TYPE=""
SYSTEM_MODE=""
TENANT_TYPE=""
# RC-014: no shared cache/pub-sub exists. Deployed multi-replica runtimes keep
# materialized cache disabled; singleflight still coalesces simultaneous reads.
DASHBOARD_CACHE_MODE="auto"
DASHBOARD_CACHE_SINGLE_REPLICA="false"
DASHBOARD_CACHE_TTL_MS="5000"
DASHBOARD_CACHE_INVALIDATION_SLA_MS="5000"
DASHBOARD_CACHE_MAX_ENTRIES="500"

# Public storefront. Keep disabled until migration, configuration and staging checks pass.
STOREFRONT_PUBLIC_READ_ENABLED="false"
STOREFRONT_ORDERING_ENABLED="false"
STOREFRONT_TOKEN_SECRET=""

# Pagar.me Core API v5 (tenant secret keys are encrypted in the database)
PAGARME_ENABLED=false
PAGARME_PIX_ENABLED=false
PAGARME_CARD_ENABLED=false
# Fixed by the application; do not expose as tenant-editable configuration.
PAGARME_API_BASE_URL=https://api.pagar.me/core/v5

# Stone: manual terminal inventory only by default. Remote integration needs a
# separately contracted/homologated product and is intentionally disabled.
STONE_ENABLED=false
STONE_TERMINALS_ENABLED=false
STONE_REMOTE_PAYMENTS_ENABLED=false
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_STORE=postgres
AUTH_RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters
# Safe default: trust no forwarded headers. Set only after Railway proxy topology validation.
TRUSTED_PROXY_HOPS=0

# REL-016 readiness database statement timeout (250-5000 ms).
READINESS_DATABASE_TIMEOUT_MS=2000
# Phase 2 future Cloud SQL connection metadata. Optional today; never put
# credentials here. DATABASE_URL remains runtime and DIRECT_URL/ADMIN_DATABASE_URL admin.
DATABASE_PROVIDER="postgresql"
CLOUD_SQL_INSTANCE_CONNECTION_NAME=""
CLOUD_SQL_CONNECTOR_MODE=""
GCP_PROJECT_ID=""
GCP_REGION=""
CLOUD_SQL_DATABASE=""
# Authentication provider. Supabase remains the safe default.
AUTH_PROVIDER="supabase"
NEXTSTOCK_PROCESS_ROLE=all
AUTH_PROVIDER_MODE=supabase_only
AUTH_MIGRATION_ENABLED=false
AUTH_LEGACY_FALLBACK_ENABLED=true
SUPERTOKENS_CONNECTION_URI=
SUPERTOKENS_API_KEY=
SUPERTOKENS_APP_NAME=
SUPERTOKENS_API_DOMAIN=
SUPERTOKENS_WEBSITE_DOMAIN=
AUTH_CANARY_ENABLED=false
AUTH_CANARY_KILL_SWITCH=false
AUTH_CANARY_ALLOWLIST=
AUTH_CANARY_PERCENTAGE=0
STORAGE_WRITE_PROVIDER=supabase
GCS_STORAGE_ENABLED=false
GCS_PROJECT_ID=
GCS_STORAGE_BUCKET=
GCS_STORAGE_LOCATION=
GCS_SIGNED_URL_TTL_SECONDS=300
STORAGE_MIGRATION_ENABLED=false
STORAGE_MIGRATION_CONCURRENCY=1
STORAGE_MIGRATION_BATCH_SIZE=20
STORAGE_MIGRATION_LEASE_SECONDS=60
CUTOVER_DRY_RUN=true
CUTOVER_ALLOW_PRODUCTION=false
CUTOVER_SOURCE_ADMIN_DATABASE_URL=
CUTOVER_TARGET_ADMIN_DATABASE_URL=
CUTOVER_REPORT_PATH=
CUTOVER_CONFIRMATION_TOKEN=
CUTOVER_TIMEOUT_MS=120000
GCP_PROJECT_ID=
GCP_REGION=
CLOUD_RUN_SERVICE=
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
CLOUD_SQL_CONNECTOR_MODE=off
CLOUD_SQL_DATABASE=
AUDIT_OUTBOX_BATCH_SIZE=20
AUTH_RATE_LIMIT_ENABLED=false
# Required only when AUTH_RATE_LIMIT_ENABLED=true; use a random secret of at least 32 characters.
AUTH_RATE_LIMIT_HMAC_SECRET=
